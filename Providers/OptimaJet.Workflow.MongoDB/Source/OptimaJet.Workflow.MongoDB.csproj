<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net472</TargetFrameworks>
    <PackageId>WorkflowEngine.NETCore-ProviderForMongoDB</PackageId>
    <Description>MongoDB persistence provider for Workflow Engine by Optimajet. Stores workflow schemes, process instances, parameters, timers, and history and creates its collections and indexes at runtime.</Description>
    <PackageTags>workflow-engine workflow dotnet csharp mongodb cosmos-db persistence optimajet</PackageTags>
    <PackageProjectUrl>https://workflowengine.io/products/dotnet-workflow-engine/?utm_source=nuget&amp;utm_medium=referral&amp;utm_campaign=workflowengine.netcore-providerformongodb&amp;utm_content=project-website</PackageProjectUrl>
    <RootNamespace>OptimaJet.Workflow.MongoDB</RootNamespace>
    <AssemblyName>OptimaJet.Workflow.MongoDB</AssemblyName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="SharpCompress" />
    <PackageReference Include="Snappier" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WorkflowEngine.NETCore-Core" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OptimaJet.Workflow.SingleServer.Test, " />
    <InternalsVisibleTo Include="OptimaJet.Workflow.Test, " />
  </ItemGroup>
</Project>