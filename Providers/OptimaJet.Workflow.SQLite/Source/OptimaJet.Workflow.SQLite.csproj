<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>OptimaJet.Workflow.SQLite</AssemblyName>
    <RootNamespace>OptimaJet.Workflow.SQLite</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>1701;1702;8002;NU1903</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CSENSE012;CSENSE026</WarningsNotAsErrors>
  </PropertyGroup>
  <!-- Targets -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <!-- Nuget -->
  <PropertyGroup>
    <PackageId>WorkflowEngine.NETCore-ProviderForSQLite</PackageId>
    <Description>SQLite persistence provider for evaluating Workflow Engine by Optimajet in self-contained .NET 8 and .NET 10 applications. It stores workflow data locally and applies the required database migrations.</Description>
    <PackageTags>workflow-engine workflow dotnet csharp sqlite evaluation persistence optimajet</PackageTags>
    <PackageProjectUrl>https://workflowengine.io/products/dotnet-workflow-engine/?utm_source=nuget&amp;utm_medium=referral&amp;utm_campaign=workflowengine.netcore-providerforsqlite&amp;utm_content=project-website</PackageProjectUrl>
  </PropertyGroup>
  <!-- Dependencies -->
  <ItemGroup>
    <PackageReference Include="WorkflowEngine.NETCore-Core" Version="23.0.1" />
    <PackageReference Include="WorkflowEngine.NETCore-Migrator" Version="23.0.1" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net8.0' ">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.32" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.32" />
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' == 'net10.0' ">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.21" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentMigrator.Runner.SQLite" Version="5.2.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommentSense" Version="1.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OptimaJet.Workflow.SingleServer.Test, " />
    <InternalsVisibleTo Include="OptimaJet.Workflow.Test, " />
  </ItemGroup>
  <!-- Includes -->
  <PropertyGroup>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Scripts\InitialWorkflowEngineSchema.sql" />
    <EmbeddedResource Include="Scripts\InitialWorkflowEngineSchema.sql" />
    <None Remove="Scripts\CreateUniqueIndexes.sql" />
    <EmbeddedResource Include="Scripts\CreateUniqueIndexes.sql" />
    <None Remove="Scripts\CreateWorkflowForms.sql" />
    <EmbeddedResource Include="Scripts\CreateWorkflowForms.sql" />
    <None Remove="Scripts\RemoveDeterminingParametersColumns.sql" />
    <EmbeddedResource Include="Scripts\RemoveDeterminingParametersColumns.sql" />
    <None Remove="Scripts\WorkflowTenantIdAndSchemeId.sql" />
    <EmbeddedResource Include="Scripts\WorkflowTenantIdAndSchemeId.sql" />
    <None Remove="Scripts\RemoveAssignmentCheckDeadlinesSystemProcess.sql" />
    <EmbeddedResource Include="Scripts\RemoveAssignmentCheckDeadlinesSystemProcess.sql" />
    <None Remove="Scripts\CreateCalendarNameColumn.sql" />
    <EmbeddedResource Include="Scripts\CreateCalendarNameColumn.sql" />
  </ItemGroup>
</Project>