<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>OptimaJet.Workflow.MSSQL</RootNamespace>
    <AssemblyName>OptimaJet.Workflow.MSSQL</AssemblyName>
    <PackageId>WorkflowEngine.NETCore-ProviderForMSSQL</PackageId>
    <Description>SQL Server and Azure SQL persistence provider for Workflow Engine by Optimajet. Stores workflow schemes, process instances, parameters, timers, and history, and applies the required database migrations.</Description>
    <PackageTags>workflow-engine workflow dotnet csharp sql-server azure-sql persistence optimajet</PackageTags>
    <PackageProjectUrl>https://workflowengine.io/products/dotnet-workflow-engine/?utm_source=nuget&amp;utm_medium=referral&amp;utm_campaign=workflowengine.netcore-providerformssql&amp;utm_content=project-website</PackageProjectUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <OutputPath>..\DLL\NETCORE\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Properties\Settings.Designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Properties\Settings.settings" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="System.Runtime.Caching" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WorkflowEngine.NETCore-Core" />
    <PackageReference Include="WorkflowEngine.NETCore-Migrator" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="OptimaJet.Workflow.SingleServer.Test, " />
    <InternalsVisibleTo Include="OptimaJet.Workflow.Test, " />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Scripts\InitialWorkflowEngineSchema.sql" />
    <EmbeddedResource Include="Scripts\InitialWorkflowEngineSchema.sql" />
    <None Remove="Scripts\CreateUniqueIndexes.sql" />
    <EmbeddedResource Include="Scripts\CreateUniqueIndexes.sql" />
    <None Remove="Scripts\CreateWorkflowForms.sql" />
    <EmbeddedResource Include="Scripts\CreateWorkflowForms.sql" />
    <None Remove="Scripts\RemoveConstraintsFromDeterminingParametersColumns.sql" />
    <EmbeddedResource Include="Scripts\RemoveConstraintsFromDeterminingParametersColumns.sql" />
    <None Remove="Scripts\WorkflowTenantIdAndSchemeId.sql" />
    <EmbeddedResource Include="Scripts\WorkflowTenantIdAndSchemeId.sql" />
    <None Remove="Scripts\RemoveAssignmentCheckDeadlinesSystemProcess.sql" />
    <EmbeddedResource Include="Scripts\RemoveAssignmentCheckDeadlinesSystemProcess.sql" />
    <None Remove="Scripts\DropEmptyWorkflowProcessAssignmentTable.sql" />
    <EmbeddedResource Include="Scripts\DropEmptyWorkflowProcessAssignmentTable.sql" />
    <None Remove="Scripts\CreateCalendarNameColumn.sql" />
    <EmbeddedResource Include="Scripts\CreateCalendarNameColumn.sql" />
  </ItemGroup>
</Project>