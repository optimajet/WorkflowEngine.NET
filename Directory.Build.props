<Project>
  <!-- Version -->
  <PropertyGroup>
    <Version>23.0.1</Version>
    <AssemblyVersion>23.0.0</AssemblyVersion>
    <FileVersion>23.0.0</FileVersion>
  </PropertyGroup>
  <!-- Build -->
  <PropertyGroup>
    <LangVersion>12</LangVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>Workflow.snk</AssemblyOriginatorKeyFile>
    <NoWarn>NU1903</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);NU5048;NU5125</WarningsAsErrors>
  </PropertyGroup>
  <!-- Nuget -->
  <PropertyGroup>
    <Company>Optimajet Limited</Company>
    <Product>Workflow Engine</Product>
    <Authors>Optimajet Limited</Authors>
    <Copyright>OptimaJet Workflow Engine 2026</Copyright>
    <PackageProjectUrl>https://workflowengine.io</PackageProjectUrl>
    <PackageReleaseNotes>https://docs.workflowengine.io/release-notes/</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/optimajet/WorkflowEngine.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE.md" Pack="true" PackagePath="$(PackageLicenseFile)" />
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="$(PackageIcon)" />
  </ItemGroup>
</Project>